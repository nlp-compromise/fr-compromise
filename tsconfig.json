{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["types/**/*", "tests/typescript/**/*.ts"]
}
